# budget-guard deploy-time parameters. Not secrets.
# To override, copy to `.env.<projectId>` (for example `.env.mcl-portal`). That file is gitignored.
# The Firebase CLI reads it on `firebase deploy`.

# Pub/Sub topic the $20/month Cloud Billing budget publishes to (in this same project).
BUDGET_GUARD_TOPIC=budget-guard

# true = log what would happen but never detach billing. Use it for the safe test, then set it back to false.
BUDGET_GUARD_DRY_RUN=false
