rules_version = '2';

// MCL Portal Storage rules. Uses cross-service Firestore lookups (users/{uid}, ads/{adId}).
// Tests: rules-tests/storage.rules.test.ts (npm run test:rules).

service firebase.storage {
  match /b/{bucket}/o {
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return request.auth != null && userDoc().status == 'active';
    }

    function hasAnyRole(roles) {
      return isActiveUser() && userDoc().roles.hasAny(roles);
    }

    function isApproved(adId) {
      return firestore.get(/databases/(default)/documents/ads/$(adId)).data.status == 'approved';
    }

    // ARCHITECTURE.md: ad-images/{uid}/{adId}/{filename}; jpeg/png/webp; max 10 MB.
    match /ad-images/{uid}/{adId}/{filename} {
      // Owner, approvers/admins, or any active user once the ad is approved.
      allow read: if isActiveUser() && (
        request.auth.uid == uid ||
        hasAnyRole(['adBookApprover', 'departmentAdmin', 'nationalAdmin', 'siteAdmin']) ||
        isApproved(adId)
      );
      // Write own path only.
      allow create, update: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isActiveUser() && (
        request.auth.uid == uid || hasAnyRole(['departmentAdmin', 'nationalAdmin', 'siteAdmin'])
      );
    }
  }
}
