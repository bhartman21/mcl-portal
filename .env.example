# Copy to .env.local (gitignored) and fill in from Firebase console > Project settings > Your apps.
# Then run: npm run config:env && npm run start:firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=mcl-portal.firebaseapp.com
FIREBASE_PROJECT_ID=mcl-portal
FIREBASE_STORAGE_BUCKET=mcl-portal.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
