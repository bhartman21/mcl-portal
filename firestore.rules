rules_version = '2';

// MCL Portal Firestore rules. Source of truth for permissions: ROLES_AND_PERMISSIONS.md.
// Tests: rules-tests/*.rules.test.ts (npm run test:rules).

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function userDoc() {
      return get(userPath(request.auth.uid)).data;
    }

    // Writes everywhere require users/{uid}.status == 'active' (pending/suspended cannot write).
    function isActiveUser() {
      return hasUserDoc() && userDoc().status == 'active';
    }

    function hasRole(role) {
      return isActiveUser() && role in userDoc().roles;
    }

    // Roles that count as "department or national admin" in the docs. siteAdmin counts there too
    // (ROLES_AND_PERMISSIONS.md, decided Nov 14, 2026): lock reset, self-approval, undo review,
    // the audit log, and self-approval notification recipients.
    function adminRoles() {
      return ['departmentAdmin', 'nationalAdmin', 'siteAdmin'];
    }

    function isDeptOrHigherAdmin() {
      return isActiveUser() && userDoc().roles.hasAny(adminRoles());
    }

    function isAdmin() {
      return isDeptOrHigherAdmin();
    }

    // ---------- admin grant hierarchy (ROLES_AND_PERMISSIONS.md "Admin role grants") ----------
    function nonAdminRoles() {
      return ['member', 'companyAdvertiser', 'detachmentVavsRep', 'departmentVavsRep', 'adBookApprover'];
    }

    // Roles the signed-in admin may grant AND revoke (revoke follows the grant table; inferred).
    function grantableRoles() {
      return hasRole('siteAdmin')
        ? nonAdminRoles().concat(['departmentAdmin', 'nationalAdmin', 'siteAdmin'])
        : hasRole('nationalAdmin')
          ? nonAdminRoles().concat(['departmentAdmin', 'nationalAdmin'])
          : hasRole('departmentAdmin')
            ? nonAdminRoles().concat(['departmentAdmin'])
            : [];
    }

    function auditPath(auditId) {
      return /databases/$(database)/documents/audits/$(auditId);
    }

    function rolesOrScopesChanged() {
      return request.resource.data.get('roles', []) != resource.data.get('roles', [])
        || request.resource.data.get('detachmentScopes', []) != resource.data.get('detachmentScopes', []);
    }

    // A roles/scopes change must carry a fresh roleAuditId whose audits/{id} doc is written in the
    // same batch (contents are validated by the audits create rule).
    function roleChangeAudited(uid) {
      let auditId = request.resource.data.get('roleAuditId', '');
      return auditId is string
        && auditId != ''
        && auditId != resource.data.get('roleAuditId', '')
        && !exists(auditPath(auditId))
        && existsAfter(auditPath(auditId))
        && getAfter(auditPath(auditId)).data.targetUid == uid;
    }

    // An audits/{id} roleChange entry is valid only alongside the matching users/{target} write.
    function roleAuditMatchesUserWrite(auditId, a) {
      let before = get(userPath(a.targetUid)).data;
      let after = getAfter(userPath(a.targetUid)).data;
      return after.get('roleAuditId', '') == auditId
        && before.get('roleAuditId', '') != auditId
        && a.beforeRoles == before.get('roles', [])
        && a.afterRoles == after.get('roles', [])
        && a.beforeScopes == before.get('detachmentScopes', [])
        && a.afterScopes == after.get('detachmentScopes', []);
    }

    function userScopes() {
      return userDoc().get('detachmentScopes', []);
    }

    function inDetachmentScope(detachmentId) {
      return hasRole('detachmentVavsRep') && detachmentId in userScopes();
    }

    // settings/registration.mode; missing doc or field means the documented default 'open'.
    function registrationMode() {
      let path = /databases/$(database)/documents/settings/registration;
      return exists(path) ? get(path).data.get('mode', 'open') : 'open';
    }

    function newUserStatus() {
      return registrationMode() == 'approval' ? 'pending' : 'active';
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // First sign-in: member role only, no detachment scopes, status set by registration mode.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'status', 'roles', 'detachmentScopes', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.roles == ['member']
        && request.resource.data.get('detachmentScopes', []) == []
        && request.resource.data.status == newUserStatus();

      // Active users may edit their own profile fields; never roles, status, scopes, uid, or email.
      allow update: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'memberNumber', 'defaultDetachmentId', 'updatedAt']);

      // Admins manage other users' roles, scopes, and status (approve, suspend) per the grant table:
      // - never their own doc (nobody raises, or accidentally drops, their own roles);
      // - only targets whose current roles are all grantable by the actor (no demoting/suspending
      //   someone above you; inferred), and only to roles the actor may grant;
      // - every roles/scopes change is audited in audits/{roleAuditId} in the same batch.
      allow update: if isAdmin()
        && request.auth.uid != uid
        && resource.data.get('roles', []).hasOnly(grantableRoles())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['roles', 'detachmentScopes', 'status', 'roleAuditId', 'updatedAt',
              'displayName', 'memberNumber', 'defaultDetachmentId'])
        && request.resource.data.status in ['active', 'pending', 'suspended']
        && request.resource.data.roles is list
        && request.resource.data.roles.size() > 0
        && request.resource.data.roles.hasOnly(grantableRoles())
        && request.resource.data.get('detachmentScopes', []) is list
        && (!rolesOrScopesChanged() || roleChangeAudited(uid));

      allow delete: if isAdmin()
        && request.auth.uid != uid
        && resource.data.get('roles', []).hasOnly(grantableRoles());
    }

    // ---------- audits (role grants/revokes; immutable, unforgeable) ----------
    match /audits/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['action', 'actorUid', 'actorRoles', 'targetUid', 'at',
              'beforeRoles', 'afterRoles', 'beforeScopes', 'afterScopes'])
        && request.resource.data.keys().hasAll(
             ['action', 'actorUid', 'actorRoles', 'targetUid', 'at',
              'beforeRoles', 'afterRoles', 'beforeScopes', 'afterScopes'])
        && request.resource.data.action == 'roleChange'
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRoles == userDoc().roles
        && request.resource.data.at == request.time
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && roleAuditMatchesUserWrite(auditId, request.resource.data);
      allow update, delete: if false;
    }

    // ---------- settings (registration lock-down switch) ----------
    match /settings/registration {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.data.mode in ['open', 'approval']
        && request.resource.data.keys().hasOnly(['mode', 'updatedAt', 'updatedBy']);
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      // registration has its own validated rule above (rules OR across matches).
      allow write: if isAdmin() && docId != 'registration';
    }

    // ---------- detachments ----------
    match /detachments/{detachmentId} {
      allow read: if resource.data.active == true || isActiveUser();
      allow write: if isAdmin();
    }

    // ---------- VAVS (Phase 2 feature; rules in place now) ----------
    match /vavsPeriods/{periodId} {
      allow read: if isActiveUser();
      allow write: if isAdmin() || hasRole('departmentVavsRep');
    }

    match /vavsEntries/{entryId} {
      allow read: if isActiveUser() && (
        resource.data.ownerUid == request.auth.uid ||
        hasRole('departmentVavsRep') ||
        isAdmin() ||
        inDetachmentScope(resource.data.detachmentId)
      );
      allow create: if isActiveUser() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isActiveUser() && (
        resource.data.ownerUid == request.auth.uid ||
        hasRole('departmentVavsRep') ||
        isAdmin() ||
        inDetachmentScope(resource.data.detachmentId)
      );
    }

    // Audit logs: written only by the acting rep/admin for an entry in their scope; immutable.
    match /vavsAuditLogs/{logId} {
      allow read: if isActiveUser() && (
        hasRole('departmentVavsRep') ||
        isAdmin() ||
        (hasRole('detachmentVavsRep') && resource.data.detachmentId in userScopes())
      );
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(
             ['id', 'entryId', 'action', 'actorUid', 'actorRole', 'detachmentId', 'at', 'before', 'after'])
        && request.resource.data.keys().hasAll(
             ['entryId', 'action', 'actorUid', 'actorRole', 'detachmentId', 'at'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['create', 'update', 'delete']
        && request.resource.data.at == request.time
        && request.resource.data.actorRole in userDoc().roles
        && (
          (request.resource.data.actorRole in ['departmentAdmin', 'nationalAdmin', 'siteAdmin'] && isAdmin()) ||
          (request.resource.data.actorRole == 'departmentVavsRep' && hasRole('departmentVavsRep')) ||
          (request.resource.data.actorRole == 'detachmentVavsRep'
            && inDetachmentScope(request.resource.data.detachmentId))
        );
      allow update, delete: if false;
    }

    // ---------- Ad Book ----------
    match /adSizes/{sizeId} {
      allow read: if resource.data.active == true || isActiveUser();
      allow write: if isAdmin() || hasRole('adBookApprover');
    }

    // Members read open books only; approvers and admins read every book (ARCHITECTURE.md
    // security outline: members "read open books", approvers/admins R/W). Member queries must
    // filter on status == 'open'.
    match /adBooks/{bookId} {
      function isBookEditor() {
        return isAdmin() || hasRole('adBookApprover');
      }

      function bookStatuses() {
        return ['draft', 'open', 'locked', 'printed'];
      }

      function oldIds() {
        return resource.data.get('adIds', []);
      }

      function newIds() {
        return request.resource.data.get('adIds', []);
      }

      // A locked or printed book takes no new placements and keeps its ads (AD_BOOK.md FR-A-4,
      // AC 4); reopen it first.
      function frozen() {
        return resource.data.status in ['locked', 'printed'];
      }

      // ownerCounts: uid -> how many ads in adIds that user owns. It changes only with a
      // placement (+1) or removal (-1) of one of that user's ads, so the rules can tell whether
      // the caller owns any ad in the book without reading every ad (issue #46).
      function oldCounts() {
        return resource.data.get('ownerCounts', {});
      }

      function newCounts() {
        return request.resource.data.get('ownerCounts', {});
      }

      function countsChangeBy(uid, delta) {
        return newCounts().diff(oldCounts()).affectedKeys().hasOnly([uid])
          && newCounts().get(uid, 0) == oldCounts().get(uid, 0) + delta
          && newCounts().get(uid, 0) >= 0;
      }

      // Issue #4: one approved ad appended to an open book, paired (same batch) with
      // ads/{adId}.bookId == this book (see the ads placement transition).
      function appendsOnePlacedAd() {
        let n = oldIds().size();
        let adId = newIds()[n];
        let ad = getAfter(/databases/$(database)/documents/ads/$(adId)).data;
        return newIds().size() == n + 1
          // the rest stay in their order (no reorder on the side)
          && newIds().removeAll([adId]) == oldIds()
          && !(adId in oldIds())
          && request.resource.data.status == 'open'
          && ad.status == 'approved'
          && ad.get('bookId', '') == bookId
          // Issue #43: nobody places their own ad.
          && ad.createdBy != request.auth.uid
          && countsChangeBy(ad.createdBy, 1);
      }

      // Issue #45: exactly one ad removed (order of the rest kept), paired (same batch) with that
      // ad's bookId no longer pointing here, and never by the ad's owner.
      function removesOneUnplacedAd() {
        let removed = oldIds().removeAll(newIds());
        let adPath = /databases/$(database)/documents/ads/$(removed[0]);
        let ad = getAfter(adPath).data;
        return removed.size() == 1
          && newIds().size() == oldIds().size() - 1
          && newIds() == oldIds().removeAll(removed)
          && existsAfter(adPath)
          && ad.get('bookId', '') != bookId
          && ad.createdBy != request.auth.uid
          && countsChangeBy(ad.createdBy, -1);
      }

      // Issue #46: page order follows adIds, so a reorder (same ids, new order) is refused to
      // anyone who owns an ad in this book.
      function reordersOnly() {
        return newIds().size() == oldIds().size()
          && newIds().toSet() == oldIds().toSet()
          && newCounts() == oldCounts()
          && oldCounts().get(request.auth.uid, 0) == 0;
      }

      allow read: if isActiveUser() && (
        resource.data.status == 'open' ||
        hasRole('adBookApprover') ||
        isAdmin()
      );
      // New books start empty.
      allow create: if isBookEditor()
        && request.resource.data.status in bookStatuses()
        && request.resource.data.get('adIds', []) == []
        && request.resource.data.get('ownerCounts', {}) == {};
      allow update: if isBookEditor()
        && request.resource.data.status in bookStatuses()
        && ((newIds() == oldIds() && newCounts() == oldCounts())
            || (!frozen() && (appendsOnePlacedAd() || removesOneUnplacedAd() || reordersOnly())));
      allow delete: if isBookEditor();
    }

    // ads: every update must match exactly one documented transition (features/AD_BOOK.md FR-A-3,
    // AC 2, 3, 12, 13). Privileged fields (status, review fields, createdBy, ...) can only change
    // through the transition that owns them.
    match /ads/{adId} {
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isOwner() {
        return resource.data.createdBy == request.auth.uid;
      }

      function canReview() {
        return hasRole('adBookApprover') || isDeptOrHigherAdmin();
      }

      function oldStatus() {
        return resource.data.status;
      }

      function newStatus() {
        return request.resource.data.status;
      }

      function nonBlank(value) {
        return value is string && value.trim().size() > 0;
      }

      // Fields the owner edits in the ad editor.
      // Issue #4: the image lives in Storage (imagePath); no image URL or data URL in Firestore.
      // bookId is the approver's placement, not owner content.
      function contentKeys() {
        return ['title', 'sizeId', 'companyName', 'imagePath', 'imageName',
                'fit', 'position', 'createdByName', 'updatedAt'];
      }

      // imagePath must point at the owner's own folder for this ad (storage.rules ad-images path).
      function imagePathOk() {
        return !('imagePath' in request.resource.data)
          || (request.resource.data.imagePath is string
              && request.resource.data.imagePath.matches(
                   'ad-images/' + request.auth.uid + '/' + adId + '/[^/]+'));
      }

      function reviewKeys() {
        return ['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectionNotes', 'updatedAt'];
      }

      function absent(key) {
        return !(key in request.resource.data);
      }

      // Submission limit (AD_BOOK.md FR-A-3, AC 9, 11): max 3 submissions; maxSubmissions is
      // fixed at create and never changes.
      function submissionsUsed() {
        return resource.data.get('submissionCount', 0);
      }

      function maxSubmissions() {
        return resource.data.get('maxSubmissions', 3);
      }

      function isLocked() {
        return resource.data.get('locked', false) == true;
      }

      // The write must be paired (same batch) with a new audits/{lastAuditId} doc for this ad,
      // written by the caller for the given action.
      function auditedAs(action) {
        let auditId = request.resource.data.get('lastAuditId', null);
        let audit = getAfter(/databases/$(database)/documents/audits/$(auditId)).data;
        return auditId is string
          && auditId != resource.data.get('lastAuditId', '')
          && audit.action == action
          && audit.entityType == 'ad'
          && audit.entityId == adId
          && audit.actorUid == request.auth.uid;
      }

      // After this write, the book named by the ad's old bookId still lists the ad.
      function stillPlacedAfter() {
        let bookId = resource.data.get('bookId', null);
        let bookPath = /databases/$(database)/documents/adBooks/$(bookId);
        return bookId is string && bookId.size() > 0
          && existsAfter(bookPath)
          && adId in getAfter(bookPath).data.get('adIds', []);
      }

      // An approved ad placed in a locked (or printed) book must be removed from the book first.
      function placedInLockedBook() {
        let bookId = resource.data.get('bookId', null);
        let bookPath = /databases/$(database)/documents/adBooks/$(bookId);
        return bookId is string && bookId.size() > 0
          && existsAfter(bookPath)
          && getAfter(bookPath).data.status in ['locked', 'printed']
          && adId in getAfter(bookPath).data.get('adIds', [adId]);
      }

      allow read: if isActiveUser() && (
        resource.data.createdBy == request.auth.uid ||
        hasRole('adBookApprover') ||
        isDeptOrHigherAdmin()
      );

      // New ads are always the caller's own draft with no review state.
      allow create: if isActiveUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.get('createdByType', 'member') == 'member'
        && request.resource.data.get('submissionCount', 0) == 0
        && request.resource.data.get('maxSubmissions', 3) == 3
        && request.resource.data.get('locked', false) == false
        && imagePathOk()
        && request.resource.data.keys().hasOnly(
             contentKeys().concat(['id', 'departmentId', 'status', 'createdBy', 'createdByType', 'createdAt',
                                   'submissionCount', 'maxSubmissions', 'locked']));

      // Owner edits a draft or rejected ad (editing a rejected ad returns it to draft).
      // A locked ad (3rd rejection) can't be edited until an admin resets it.
      allow update: if oldStatus() in ['draft', 'rejected'] && newStatus() in ['draft', 'rejected']
        && isOwner() && isActiveUser()
        && !isLocked()
        && (newStatus() == oldStatus() || (oldStatus() == 'rejected' && newStatus() == 'draft'))
        && imagePathOk()
        && changedKeys().hasOnly(contentKeys().concat(['status']));

      // Owner submits a draft or rejected ad (may save content in the same write; clears notes).
      // Each submit adds exactly 1 to submissionCount; the 4th submit is denied.
      allow update: if oldStatus() in ['draft', 'rejected'] && newStatus() == 'submitted'
        && isOwner() && isActiveUser()
        && !isLocked()
        && request.resource.data.get('submissionCount', 0) == submissionsUsed() + 1
        && request.resource.data.get('submissionCount', 0) <= maxSubmissions()
        && imagePathOk()
        && changedKeys().hasOnly(contentKeys().concat(['status', 'submittedAt', 'rejectionNotes', 'submissionCount']))
        && absent('rejectionNotes');

      // Owner withdraws a submitted ad back to draft (AD_BOOK.md FR-A-3, AC 10). Status only:
      // the submission attempt is not refunded.
      allow update: if oldStatus() == 'submitted' && newStatus() == 'draft'
        && isOwner() && isActiveUser()
        && changedKeys().hasOnly(['status', 'updatedAt']);

      // A different approver or admin approves a submitted ad.
      allow update: if oldStatus() == 'submitted' && newStatus() == 'approved'
        && !isOwner() && canReview()
        && request.resource.data.reviewedBy == request.auth.uid
        && changedKeys().hasOnly(reviewKeys().concat(['selfApproved', 'selfApprovalReason']))
        && absent('rejectionNotes')
        && absent('selfApproved')
        && absent('selfApprovalReason');

      // A department, national, or site admin self-approves only with a reason; audited (AC 12).
      allow update: if oldStatus() == 'submitted' && newStatus() == 'approved'
        && isOwner() && isDeptOrHigherAdmin()
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.selfApproved == true
        && nonBlank(request.resource.data.selfApprovalReason)
        && changedKeys().hasOnly(reviewKeys().concat(['selfApproved', 'selfApprovalReason', 'lastAuditId']))
        && absent('rejectionNotes')
        && auditedAs('selfApprove');

      // A different approver or admin rejects with notes (min 5 chars). Nobody self-rejects.
      allow update: if oldStatus() == 'submitted' && newStatus() == 'rejected'
        && !isOwner() && canReview()
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.rejectionNotes is string
        && request.resource.data.rejectionNotes.trim().size() >= 5
        // The rejection of the last allowed submission locks the ad.
        && request.resource.data.get('locked', false) == (submissionsUsed() >= maxSubmissions())
        && changedKeys().hasOnly(reviewKeys().concat(['locked']));

      // Admin undoes an approval or rejection with a reason (AC 13): back to submitted, review
      // fields cleared, submissionCount untouched, audited; not while placed in a locked book.
      allow update: if oldStatus() in ['approved', 'rejected'] && newStatus() == 'submitted'
        && isDeptOrHigherAdmin()
        && changedKeys().hasOnly(reviewKeys().concat(['selfApproved', 'selfApprovalReason', 'lastAuditId', 'locked', 'bookId']))
        && request.resource.data.get('locked', false) == false
        && absent('reviewedBy') && absent('reviewedByName') && absent('reviewedAt')
        && absent('rejectionNotes') && absent('selfApproved') && absent('selfApprovalReason')
        && auditedAs('undoReview')
        && !placedInLockedBook()
        // Issue #4: it also comes out of its (open) book in the same batch.
        && absent('bookId') && !stillPlacedAfter();

      // Issue #4: an approver or admin places an approved ad in an open book, or takes it out of a
      // book that is not locked/printed; the book's adIds change in the same batch.
      // Issue #43: never their own ad (same as approve/reject).
      allow update: if oldStatus() == 'approved' && newStatus() == 'approved'
        && !isOwner() && canReview()
        && changedKeys().hasOnly(['bookId', 'updatedAt'])
        && changedKeys().hasAny(['bookId'])
        && (
          // place
          (resource.data.get('bookId', '') == ''
            && request.resource.data.bookId is string
            && existsAfter(/databases/$(database)/documents/adBooks/$(request.resource.data.bookId))
            && getAfter(/databases/$(database)/documents/adBooks/$(request.resource.data.bookId)).data.status == 'open'
            && adId in getAfter(/databases/$(database)/documents/adBooks/$(request.resource.data.bookId)).data.get('adIds', []))
          // remove
          || (absent('bookId') && !stillPlacedAfter() && !placedInLockedBook())
        );

      // Admin lock reset (AD_BOOK.md FR-A-3, AC 11): clears locked, submissionCount = 0, back to
      // draft, audited (who, when, reason).
      allow update: if isLocked() && newStatus() == 'draft'
        && isDeptOrHigherAdmin()
        && request.resource.data.submissionCount == 0
        && request.resource.data.locked == false
        && changedKeys().hasOnly(['status', 'submissionCount', 'locked', 'lockResets', 'lastAuditId', 'updatedAt'])
        && (!changedKeys().hasAny(['lockResets'])
            || (request.resource.data.lockResets is list
                && request.resource.data.lockResets.size() == resource.data.get('lockResets', []).size() + 1))
        && auditedAs('lockReset');

      // Only the owner deletes, and only while draft (AD_BOOK.md FR-A-3, AC 10). Approvers and
      // admins can't delete members' ads; withdraw is the path for a submitted ad.
      allow delete: if resource.data.status == 'draft' && isOwner() && isActiveUser();
    }

    // ---------- audits (Ad Book review decisions; admins only, immutable) ----------
    match /audits/{auditId} {
      allow read: if isDeptOrHigherAdmin();
      // Must be written in the same batch as the ad change it records (ads.lastAuditId == auditId).
      allow create: if isDeptOrHigherAdmin()
        && request.resource.data.keys().hasOnly(
             ['entityType', 'entityId', 'action', 'actorUid', 'actorName', 'at', 'reason', 'fromStatus', 'toStatus'])
        && request.resource.data.keys().hasAll(['entityType', 'entityId', 'action', 'actorUid', 'at'])
        && request.resource.data.entityType == 'ad'
        && request.resource.data.action in ['selfApprove', 'undoReview', 'lockReset']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.get('reason', '') is string
        // Reason is required for self-approval and undo; optional for a lock reset.
        && (request.resource.data.action == 'lockReset'
            || request.resource.data.get('reason', '').trim().size() > 0)
        && getAfter(/databases/$(database)/documents/ads/$(request.resource.data.entityId))
             .data.get('lastAuditId', null) == auditId;
      allow update, delete: if false;
    }

    // ---------- notifications (in-app only; AD_BOOK.md AC 2/12) ----------
    match /notifications/{notificationId} {
      allow read: if isActiveUser() && resource.data.recipientUid == request.auth.uid;

      // Only the recipient marks their own notification read.
      allow update: if isActiveUser()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;

      // An admin who self-approved an ad notifies another admin about that ad.
      allow create: if isDeptOrHigherAdmin()
        && request.resource.data.keys().hasOnly(
             ['recipientUid', 'type', 'adId', 'adTitle', 'actorUid', 'actorName', 'reason', 'createdAt', 'read'])
        && request.resource.data.keys().hasAll(['recipientUid', 'type', 'adId', 'actorUid', 'reason', 'createdAt', 'read'])
        && request.resource.data.type == 'adSelfApproved'
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid))
             .data.roles.hasAny(adminRoles())
        && getAfter(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.get('selfApproved', false) == true;

      allow delete: if false;
    }
  }
}
